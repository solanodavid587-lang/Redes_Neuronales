# Copy to .env and replace placeholders with local project settings.
APP_ENV=development
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=replace-with-database-password
# Optional fallback; leave empty when using the DB_* variables above.
DATABASE_URL=
# Required for local user login and backend-issued JWTs. Generate a long random value.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
# Private directory for uploaded dataset files. Use persistent storage in deployments.
DATASET_STORAGE_DIR=data/datasets
# Optional in development; required for shared production storage.
S3_BUCKET=
# Copy the project region and S3 endpoint from Supabase Storage settings.
S3_REGION=project_region
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private Hugging Face dataset repository. Keep the token server-side only.
HF_TOKEN=
HF_DATASET_REPO_ID=
# Supabase project URL; local login uses the API's own JWT secret.
SUPABASE_URL=https://PROJECT_REF.supabase.co
WORKER_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
