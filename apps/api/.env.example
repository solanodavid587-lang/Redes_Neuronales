# Copy to .env and replace placeholders with local project settings.
APP_ENV=development
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=replace-with-database-password
# Optional fallback; leave empty when using the DB_* variables above.
DATABASE_URL=
# Required for local user login and backend-issued JWTs. Generate a long random value.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
# Supabase Storage configuration; not used for login.
SUPABASE_URL=https://PROJECT_REF.supabase.co
WORKER_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
